{
  "info": {
    "name": "Healthcare Django Assignment",
    "_postman_id": "healthcare-assessment-demo",
    "description": "Run requests in order. Collection saves token and entity IDs automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "patient_id",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "mapping_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"StrongPass!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "02 Login (saves JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/login/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"StrongPass!2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"access_token\", pm.response.json().access);",
              "pm.collectionVariables.set(\"refresh_token\", pm.response.json().refresh);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Create patient (saves ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/patients/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patients",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Patient\",\n  \"age\": 30,\n  \"gender\": \"female\",\n  \"phone\": \"+919876543210\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"patient_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get my patients",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/patients/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patients",
            ""
          ]
        }
      }
    },
    {
      "name": "05 Get one patient",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/patients/{{patient_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patients",
            "{{patient_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "06 Update patient",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/patients/{{patient_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patients",
            "{{patient_id}}",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Patient Updated\",\n  \"age\": 31,\n  \"gender\": \"female\",\n  \"phone\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "07 Create doctor (saves ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/doctors/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "doctors",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Meera Sharma\",\n  \"specialization\": \"Cardiology\",\n  \"email\": \"meera@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"doctor_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Get all doctors",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/doctors/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "doctors",
            ""
          ]
        }
      }
    },
    {
      "name": "09 Get one doctor",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctor_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "10 Update doctor",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctor_id}}",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Meera Sharma\",\n  \"specialization\": \"General Medicine\",\n  \"email\": \"meera@example.com\",\n  \"phone\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "11 Assign doctor (saves mapping ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/mappings/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mappings",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patient\": {{patient_id}},\n  \"doctor\": {{doctor_id}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"mapping_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 My patient-doctor mappings",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mappings/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mappings",
            ""
          ]
        }
      }
    },
    {
      "name": "13 Doctors for selected patient",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mappings/{{patient_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mappings",
            "{{patient_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "14 Remove assignment",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/mappings/{{mapping_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "mappings",
            "{{mapping_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "15 Delete doctor",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "doctors",
            "{{doctor_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "16 Delete patient",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/patients/{{patient_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "patients",
            "{{patient_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "17 Refresh JWT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/refresh/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "refresh",
            ""
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"access_token\", pm.response.json().access);"
            ]
          }
        }
      ]
    }
  ]
}